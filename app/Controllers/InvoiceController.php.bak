    public function index(): void
    {
        $this->requireLogin();

        $invoices = [];

        try {
            $pdo = $this->db();

            $this->autoGenerateMonthlyInvoices($pdo);

            $pdo->query("
                UPDATE invoices
                SET status = 'OVERDUE'
                WHERE status = 'ISSUED'
                AND due_date IS NOT NULL
                AND due_date < DATE_SUB(CURDATE(), INTERVAL 3 DAY)
            ");

            $this->sendOverdueReminders($pdo);

            $stmt = $pdo->query("
                SELECT id, customer_id, amount, due_date, status, created_at
                FROM invoices
                ORDER BY id DESC
            ");

            $invoices = $stmt->fetchAll();

            if (!empty($invoices)) {
                $customerIds = [];

                foreach ($invoices as $inv) {
                    $cid = (int)($inv['customer_id'] ?? 0);
                    if ($cid > 0) {
                        $customerIds[$cid] = true;
                    }
                }

                $customerIds = array_keys($customerIds);
                $customerMap = [];

                if (!empty($customerIds)) {
                    $placeholders = implode(',', array_fill(0, count($customerIds), '?'));
                    $cstmt = $pdo->prepare("SELECT id, full_name FROM customers WHERE id IN ($placeholders)");
                    $cstmt->execute($customerIds);

                    foreach ($cstmt->fetchAll() as $c) {
                        $customerMap[(int)$c['id']] = $c['full_name'];
                    }
                }

                foreach ($invoices as &$inv) {
                    $cid = (int)($inv['customer_id'] ?? 0);
                    $inv['customer_name'] = $customerMap[$cid] ?? ('Customer #' . $cid);
                }
                unset($inv);
            }

        } catch (Throwable $e) {
            error_log("InvoiceController@index error: " . $e->getMessage());
        }

        View::render('invoices/index', [
            'title' => 'Invoices',
            'invoices' => $invoices,
        ]);
    }

    public function create(): void
    {
        $this->requireLogin();

        $customers = [];
        $defaultDue = date('Y-m-d', strtotime('+7 days'));

        try {
            $pdo = $this->db();

            $customers = $pdo->query("
                SELECT id, full_name
                FROM customers
                ORDER BY full_name ASC
            ")->fetchAll();

        } catch (Throwable $e) {
            error_log("InvoiceController@create error: " . $e->getMessage());
        }

        View::render('invoices/create', [
            'title' => 'Generate Invoice',
            'customers' => $customers,
            'defaultDue' => $defaultDue,
        ]);
    }

    public function store(): void
    {
        $this->requireLogin();

        try {
            $pdo = $this->db();

            $customerId = (int)($_POST['customer_id'] ?? 0);
            $amount     = trim($_POST['amount'] ?? '');
            $dueDate    = trim($_POST['due_date'] ?? '');
            $status     = $_POST['status'] ?? 'ISSUED';

            if ($customerId <= 0) {
                header('Location: /invoices/create');
                exit;
            }

            if ($amount === '' || !is_numeric($amount)) {
                header('Location: /invoices/create');
                exit;
            }

            if ($dueDate === '') {
                $dueDate = date('Y-m-d', strtotime('+7 days'));
            }

            if (!in_array($status, ['ISSUED', 'PAID'], true)) {
                $status = 'ISSUED';
            }

            $stmt = $pdo->prepare("
                INSERT INTO invoices (customer_id, amount, due_date, status)
                VALUES (?, ?, ?, ?)
            ");
            $stmt->execute([$customerId, $amount, $dueDate, $status]);

        } catch (Throwable $e) {
            error_log("InvoiceController@store error: " . $e->getMessage());
        }

        header('Location: /invoices');
        exit;
    }

    public function view(): void
    {
        $this->requireLogin();

        try {
            $pdo = $this->db();

            $id = (int)($_GET['id'] ?? 0);
            if ($id <= 0) {
                header('Location: /invoices');
                exit;
            }

            $stmt = $pdo->prepare("
                SELECT i.*, c.full_name AS customer_name, c.email, c.phone, c.address
                FROM invoices i
                LEFT JOIN customers c ON c.id = i.customer_id
                WHERE i.id = ?
                LIMIT 1
            ");

            $stmt->execute([$id]);
            $invoice = $stmt->fetch();

            if (!$invoice) {
                header('Location: /invoices');
                exit;
            }

            View::render('invoices/view', [
                'title' => 'View Invoice',
                'invoice' => $invoice,
            ]);

        } catch (Throwable $e) {
            error_log("InvoiceController@view error: " . $e->getMessage());
            header('Location: /invoices');
            exit;
        }
    }

    public function outstandingReport(): void
    {
        $this->requireLogin();

        try {
            $pdo = $this->db();

            $stmt = $pdo->query("
                SELECT
                    invoices.id,
                    invoices.customer_id,
                    invoices.amount,
                    invoices.due_date,
                    invoices.status,
                    invoices.created_at,
                    customers.full_name
                FROM invoices
                LEFT JOIN customers ON invoices.customer_id = customers.id
                WHERE invoices.status IN ('ISSUED', 'OVERDUE')
                ORDER BY invoices.due_date ASC, invoices.id DESC
            ");

            $invoices = $stmt->fetchAll();

            View::render('reports/outstanding', [
                'invoices' => $invoices
            ]);
        } catch (Throwable $e) {
            error_log('InvoiceController@outstandingReport error: ' . $e->getMessage());
            header('Location: /dashboard');
            exit;
        }
    }

    public function delete(): void
    {
        $this->requireLogin();

        try {
            $pdo = $this->db();

            $id = (int)($_GET['id'] ?? 0);

            if ($id <= 0) {
                header('Location: /invoices');
                exit;
            }

            $stmt = $pdo->prepare("DELETE FROM payments WHERE invoice_id = ?");
            $stmt->execute([$id]);

            $stmt = $pdo->prepare("DELETE FROM notifications WHERE invoice_id = ?");
            $stmt->execute([$id]);

            $stmt = $pdo->prepare("DELETE FROM invoices WHERE id = ?");
            $stmt->execute([$id]);

        } catch (Throwable $e) {
            error_log("InvoiceController@delete error: " . $e->getMessage());
        }

        header('Location: /invoices');
        exit;
    }

    public function pdf(): void
    {
        $this->requireLogin();

        try {
            if (!file_exists(__DIR__ . '/../../vendor/autoload.php')) {
                header('Content-Type: text/html; charset=utf-8');
                echo '<h2>PDF library not installed.</h2>';
                echo '<p>Run: <code>composer require dompdf/dompdf</code></p>';
                exit;
            }

            require_once __DIR__ . '/../../vendor/autoload.php';

            if (!class_exists('\\Dompdf\\Dompdf')) {
                header('Content-Type: text/html; charset=utf-8');
                echo '<h2>Dompdf class not found.</h2>';
                echo '<p>Run: <code>composer require dompdf/dompdf</code></p>';
                exit;
            }

            $pdo = $this->db();

            $id = (int)($_GET['id'] ?? 0);
            if ($id <= 0) {
                header('Location: /invoices');
                exit;
            }

            $pdfData = $this->getInvoicePdfData($pdo, $id);
            if (!$pdfData) {
                header('Location: /invoices');
                exit;
            }

            $dompdf = new \Dompdf\Dompdf();
            $dompdf->loadHtml($pdfData['html']);
            $dompdf->setPaper('A4', 'portrait');
            $dompdf->render();
            $dompdf->stream('invoice-' . $pdfData['invoice_id'] . '.pdf', ['Attachment' => false]);
            exit;
        } catch (Throwable $e) {
            error_log("InvoiceController@pdf error: " . $e->getMessage());
            header('Location: /invoices');
            exit;
        }
    }

    public function emailPdf(): void
    {
        $this->requireLogin();

        try {
            if (!file_exists(__DIR__ . '/../../vendor/autoload.php')) {
                header('Content-Type: text/html; charset=utf-8');
                echo '<h2>PDF library not installed.</h2>';
                echo '<p>Run: <code>composer require dompdf/dompdf</code></p>';
                exit;
            }

            require_once __DIR__ . '/../../vendor/autoload.php';

            if (!class_exists('\\Dompdf\\Dompdf')) {
                header('Content-Type: text/html; charset=utf-8');
                echo '<h2>Dompdf class not found.</h2>';
                echo '<p>Run: <code>composer require dompdf/dompdf</code></p>';
                exit;
            }

            if (!class_exists('MailService')) {
                header('Content-Type: text/html; charset=utf-8');
                echo '<h2>MailService not found.</h2>';
                exit;
            }

            $pdo = $this->db();

            $id = (int)($_GET['id'] ?? 0);
            if ($id <= 0) {
                header('Location: /invoices');
                exit;
            }

            $pdfData = $this->getInvoicePdfData($pdo, $id);
            if (!$pdfData) {
                header('Location: /invoices');
                exit;
            }

            $customerEmail = trim($pdfData['customer_email_raw']);
            $customerName  = $pdfData['customer_name_raw'];
            $invoiceId     = (int)$pdfData['invoice_id'];

            if ($customerEmail === '') {
                $this->renderInvoiceMessagePage(
                    'Customer Email Missing',
                    'Please add an email address to this customer before sending the invoice.',
                    'Back to Invoice',
                    '/invoices/view?id=' . $invoiceId,
                    false
                );
                exit;
            }

            $dompdf = new \Dompdf\Dompdf();
            $dompdf->loadHtml($pdfData['html']);
            $dompdf->setPaper('A4', 'portrait');
            $dompdf->render();

            $pdfBinary = $dompdf->output();
            $filename = 'invoice-' . $invoiceId . '.pdf';

            $subject = 'Your Invoice #' . $invoiceId . ' - ISP-BILLING-LITE';
            $body = '
                <h2>Invoice PDF Attached</h2>
                <p>Hello ' . htmlspecialchars($customerName, ENT_QUOTES, 'UTF-8') . ',</p>
                <p>Please find attached your invoice <strong>#' . htmlspecialchars((string)$invoiceId, ENT_QUOTES, 'UTF-8') . '</strong>.</p>
                <p>Please review the invoice and settle the payment on or before the due date.</p>
                <br>
                <p>Regards,<br>ISP-BILLING-LITE</p>
            ';

            $mailService = new MailService();
            $sent = $mailService->sendWithAttachment(
                $customerEmail,
                $customerName,
                $subject,
                $body,
                $filename,
                $pdfBinary,
                'application/pdf'
            );

            if ($sent) {
                $this->renderInvoiceMessagePage(
                    'Invoice Email Sent',
                    'The invoice PDF was successfully sent to ' . $customerEmail . '.',
                    'Back to Invoice',
                    '/invoices/view?id=' . $invoiceId,
                    true
                );
                exit;
            }

            $this->renderInvoiceMessagePage(
                'Invoice Email Failed',
                'Please check your mail configuration and try again.',
                'Back to Invoice',
                '/invoices/view?id=' . $invoiceId,
                false
            );
            exit;

        } catch (Throwable $e) {
            error_log("InvoiceController@emailPdf error: " . $e->getMessage());
            $this->renderInvoiceMessagePage(
                'System Error',
                'Unable to send invoice email right now.',
                'Back to Invoices',
                '/invoices',
                false
            );
            exit;
        }
    }

    public function billingList(): void
    {
        $this->requireLogin();

        $pdo = $this->db();

        $selectedYear = (int)($_GET['year'] ?? date('Y'));
        if ($selectedYear < 2000 || $selectedYear > 2100) {
            $selectedYear = (int)date('Y');
        }

        $months = [
            1  => 'Jan',
            2  => 'Feb',
            3  => 'Mar',
            4  => 'Apr',
            5  => 'May',
            6  => 'Jun',
            7  => 'Jul',
            8  => 'Aug',
            9  => 'Sep',
            10 => 'Oct',
            11 => 'Nov',
            12 => 'Dec',
        ];

        $customers = [];
        $matrixMap = [];

        try {
            $stmt = $pdo->query("
                SELECT
                    c.id AS customer_id,
                    c.full_name,
                    c.phone,
                    c.email,
                    p.name AS plan_name,
                    p.speed,
                    p.price
                FROM customers c
                LEFT JOIN subscriptions s
                    ON s.id = (
                        SELECT ss.id
                        FROM subscriptions ss
                        WHERE ss.customer_id = c.id
                        ORDER BY
                            CASE WHEN ss.status = 'ACTIVE' THEN 0 ELSE 1 END,
                            ss.created_at DESC,
                            ss.id DESC
                        LIMIT 1
                    )
                LEFT JOIN plans p
                    ON p.id = s.plan_id
                ORDER BY c.full_name ASC
            ");

            $customers = $stmt->fetchAll();

            $matrixStmt = $pdo->prepare("
                SELECT
                    customer_id,
                    billing_month,
                    status
                FROM billing_matrix
                WHERE billing_year = ?
            ");
            $matrixStmt->execute([$selectedYear]);

            $matrixRows = $matrixStmt->fetchAll();

            foreach ($matrixRows as $row) {
                $customerId = (int)($row['customer_id'] ?? 0);
                $billingMonth = (int)($row['billing_month'] ?? 0);
                $status = strtoupper((string)($row['status'] ?? 'UNPAID'));

                if ($customerId > 0 && $billingMonth >= 1 && $billingMonth <= 12) {
                    $matrixMap[$customerId][$billingMonth] = $status;
                }
            }

            foreach ($customers as &$customer) {
                $customerId = (int)($customer['customer_id'] ?? 0);
                $customer['matrix'] = [];

                foreach ($months as $monthNumber => $monthLabel) {
                    $customer['matrix'][$monthNumber] = $matrixMap[$customerId][$monthNumber] ?? 'UNPAID';
                }
            }
            unset($customer);

        } catch (Throwable $e) {
            error_log('InvoiceController@billingList matrix error: ' . $e->getMessage());
        }

        View::render('billing/index', [
            'title'        => 'Billing List',
            'customers'    => $customers,
            'months'       => $months,
            'selectedYear' => $selectedYear,
        ]);
    }

    public function updateBillingMatrixStatus(): void
    {
        $this->requireLogin();

        $pdo = $this->db();

        $customerId   = (int)($_POST['customer_id'] ?? 0);
        $billingYear  = (int)($_POST['billing_year'] ?? date('Y'));
        $billingMonth = (int)($_POST['billing_month'] ?? 0);
        $status       = strtoupper(trim((string)($_POST['status'] ?? 'UNPAID')));

        $allowedStatuses = ['PAID', 'UNPAID', 'PENDING', 'OVERDUE'];

        if ($customerId <= 0 || $billingMonth < 1 || $billingMonth > 12 || !in_array($status, $allowedStatuses, true)) {
            header('Location: /billing?year=' . urlencode((string)$billingYear));
            exit;
        }

        try {
            $stmt = $pdo->prepare("
                INSERT INTO billing_matrix (customer_id, billing_year, billing_month, status)
                VALUES (?, ?, ?, ?)
                ON DUPLICATE KEY UPDATE
                    status = VALUES(status),
                    updated_at = CURRENT_TIMESTAMP
            ");

            $stmt->execute([
                $customerId,
                $billingYear,
                $billingMonth,
                $status
            ]);
        } catch (Throwable $e) {
            error_log('InvoiceController@updateBillingMatrixStatus error: ' . $e->getMessage());
        }

        header('Location: /billing?year=' . urlencode((string)$billingYear));
        exit;
    }
}
