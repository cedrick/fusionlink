<?php

// Safety: make sure session exists
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

/**
 * Simple auth guard (NO Auth class needed)
 */
$requireLogin = function () {
    if (empty($_SESSION['user'])) {
        header('Location: /login');
        exit;
    }
};

// -------------------- PUBLIC ROUTES --------------------

$router->get('/', function () {
    $controller = new HomeController();
    $controller->index();
});

$router->get('/login', function () {
    $controller = new AuthController();
    // your project uses loginForm() on GET /login
    $controller->loginForm();
});

$router->post('/login', function () {
    $controller = new AuthController();
    // your project uses login() on POST /login
    $controller->login();
});

$router->get('/logout', function () {
    // safest logout
    $_SESSION = [];
    if (ini_get("session.use_cookies")) {
        $params = session_get_cookie_params();
        setcookie(session_name(), '', time() - 42000,
            $params["path"], $params["domain"],
            $params["secure"], $params["httponly"]
        );
    }
    session_destroy();
    header('Location: /login');
    exit;
});

$router->get('/users', function () {
    (new UserController())->index();
});

// -------------------- PROTECTED ROUTES --------------------

$router->get('/dashboard', function () use ($requireLogin) {
    $requireLogin();

    View::render('dashboard/index', [
        'title' => 'Dashboard',
        'user'  => $_SESSION['user'],
    ]);
});

// -------- Customers (protect all) --------
$router->get('/customers', function () use ($requireLogin) {
    $requireLogin();
    (new CustomerController())->index();
});

